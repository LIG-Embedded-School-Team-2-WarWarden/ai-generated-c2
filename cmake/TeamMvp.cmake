include(FetchContent)
find_package(Protobuf 3.15 QUIET)
if(NOT Protobuf_FOUND)
    set(protobuf_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    set(protobuf_BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
    set(protobuf_WITH_ZLIB OFF CACHE BOOL "" FORCE)
    set(protobuf_MSVC_STATIC_RUNTIME OFF CACHE BOOL "" FORCE)
    FetchContent_Declare(protobuf
        URL https://github.com/protocolbuffers/protobuf/archive/refs/tags/v21.12.tar.gz
        URL_HASH SHA256=22fdaf641b31655d4b2297f9981fa5203b2866f8332d3c6333f6b0107bb320de
        DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(protobuf)
endif()
find_package(nlohmann_json 3.11 QUIET)
if(NOT nlohmann_json_FOUND)
    FetchContent_Declare(json URL https://github.com/nlohmann/json/releases/download/v3.11.3/json.tar.xz DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(json)
endif()
set(C2_SCHEMA_ROOT "${PROJECT_SOURCE_DIR}/external/warwarden-protocol/proto")
set(C2_GENERATED "${PROJECT_BINARY_DIR}/generated")
file(MAKE_DIRECTORY "${C2_GENERATED}")
add_custom_command(OUTPUT "${C2_GENERATED}/mfs/icd/v1/mfs.pb.cc" "${C2_GENERATED}/mfs/icd/v1/mfs.pb.h"
    COMMAND protobuf::protoc --cpp_out=${C2_GENERATED} --proto_path=${C2_SCHEMA_ROOT} "${C2_SCHEMA_ROOT}/mfs/icd/v1/mfs.proto"
    DEPENDS protobuf::protoc "${C2_SCHEMA_ROOT}/mfs/icd/v1/mfs.proto" VERBATIM)
add_library(c2_team_proto "${C2_GENERATED}/mfs/icd/v1/mfs.pb.cc")
target_include_directories(c2_team_proto PUBLIC "${C2_GENERATED}")
target_link_libraries(c2_team_proto PUBLIC protobuf::libprotobuf)
add_library(c2_team STATIC native/domain.cpp native/transport.cpp native/observation.cpp native/devices.cpp native/effector.cpp native/observer.cpp native/requests.cpp native/pointing.cpp native/states.cpp native/engine.cpp)
target_include_directories(c2_team PUBLIC native/include PRIVATE vendor/lidar)
target_link_libraries(c2_team PUBLIC c2_team_proto nlohmann_json::nlohmann_json)
find_package(Threads REQUIRED)
target_link_libraries(c2_team PUBLIC Threads::Threads)
if(WIN32)
    target_link_libraries(c2_team PRIVATE ws2_32)
    target_compile_definitions(c2_team PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
endif()
add_executable(c2_mvp_console native/console.cpp)
target_link_libraries(c2_mvp_console PRIVATE c2_team)
if(WIN32)
    add_library(c2_gui STATIC gui/ipc_protocol.cpp gui/ipc_server.cpp gui/bridge.cpp)
    target_include_directories(c2_gui PUBLIC gui)
    target_link_libraries(c2_gui PUBLIC c2_team)
    target_link_libraries(c2_mvp_console PRIVATE c2_gui)
    add_executable(c2_gui_v2_tests tests/gui_v2.cpp)
    target_link_libraries(c2_gui_v2_tests PRIVATE c2_gui)
    add_test(NAME gui_v2 COMMAND c2_gui_v2_tests "${PROJECT_SOURCE_DIR}/configs/team-demo.json")
endif()
add_executable(c2_native_domain_tests tests/native_domain.cpp)
target_link_libraries(c2_native_domain_tests PRIVATE c2_team)
add_test(NAME native_domain COMMAND c2_native_domain_tests)
add_executable(c2_native_behavior_tests tests/native_behaviors.cpp)
target_link_libraries(c2_native_behavior_tests PRIVATE c2_team)
add_test(NAME native_behaviors COMMAND c2_native_behavior_tests)
